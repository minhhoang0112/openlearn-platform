API_HOST=127.0.0.1
API_PORT=4000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# DATABASE_PATH=server/data/openquiz.sqlite
# Optional custom AI gateway. See docs/API-CONTRACT.md.
# AI_SERVICE_URL=https://your-ai-gateway.example/generate
# AI_SERVICE_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Native audio: separate model, checked when a call starts; uses main key by default.
GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_API_KEY=
# Separate authorized project assigned to lightweight tasks (no quota failover):
# GEMINI_SECONDARY_API_KEY=
# Optional: defaults to GEMINI_MODEL; no automatic premium-model upgrade.
# GEMINI_FEEDBACK_MODEL=
# GEMINI_AUDIO_MODEL=
# Obtain your own key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
